{
  "name": "@tracefast_xyz/sdk",
  "version": "0.1.0",
  "description": "The official TypeScript SDK for the TraceFast API — Ethereum blocks, transactions, traces, tokens, contracts, DEX pools, the consensus layer, and what TraceFast states about an address.",
  "license": "MIT",
  "author": "TraceFast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datanestllc/tracefast-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/datanestllc/tracefast-sdk/issues"
  },
  "homepage": "https://tracefast.xyz",
  "keywords": [
    "tracefast",
    "ethereum",
    "evm",
    "blockchain",
    "web3",
    "sdk",
    "api",
    "api-client",
    "onchain",
    "blockchain-analytics",
    "transaction-trace",
    "smart-contracts",
    "defi",
    "dex",
    "token",
    "eip-7702",
    "forensics",
    "compliance",
    "typescript"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepack": "npm run build",
    "smoke": "node test/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
